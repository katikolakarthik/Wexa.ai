# CognoDB Cloud (required for Phase 1 connectivity test)
# Copy this file to .env and replace placeholders with values from your CognoDB console.
# Never commit .env.

COGNODB_URI=bolt+s://YOUR_INSTANCE.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=YOUR_PASSWORD

# ---------------------------------------------------------------------------
# Competitor databases (Phase 5+)
# Scripts mark missing platforms as: NOT RUN / CREDENTIALS REQUIRED
# ---------------------------------------------------------------------------

# Neo4j Aura / self-hosted
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD

# Memgraph Cloud / self-hosted
# Cloud TLS + self-signed cert: bolt+ssc://HOST:7687  (gqlalchemy encrypted=True)
# Local Docker may use bolt://localhost:7687 with empty username/password
MEMGRAPH_URI=bolt+ssc://YOUR_HOST:7687
MEMGRAPH_USERNAME=YOUR_EMAIL_OR_USERNAME
MEMGRAPH_PASSWORD=YOUR_PASSWORD

# FalkorDB Cloud / self-hosted
FALKORDB_HOST=YOUR_HOST
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
FALKORDB_GRAPH=benchmark
FALKORDB_SSL=false

# ArangoDB Oasis / self-hosted
ARANGODB_URL=https://YOUR_HOST:8529
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=YOUR_PASSWORD
ARANGODB_DATABASE=_system
